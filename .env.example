# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-key-here
CAREFLOW_LLM_MODEL=gemini/gemini-flash-lite-latest
CAREFLOW_LLM_MAX_RETRIES=7
CAREFLOW_LLM_MIN_SECONDS_BETWEEN_CALLS=7

# Staff token for POST /approvals (leave empty to switch approvals off)
CAREFLOW_STAFF_API_TOKEN=change-me-to-a-long-random-secret

# Optional tracing (leave empty to switch it off)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com